# Copy to .env (never commit .env). Used by docker-compose.yml.
MYSQL_DATABASE=real_estate_db
MYSQL_USER=real_estate_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Host port for the API (change if 8000 is taken)
API_PORT=8000

# Comma-separated browser origins allowed to call the API directly; "*" for any.
CORS_ORIGINS=*

# First super admin, created at startup if no super admin exists yet
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- File storage (listing photos, contract documents) ----
# local = Docker volume (default). s3 = any S3-compatible bucket (AWS S3, DigitalOcean Spaces,
# Cloudflare R2, Wasabi, Backblaze B2, MinIO, ...). Files are deleted from the bucket together with
# the listing / studio / contract they belong to.
STORAGE_BACKEND=local
# --- only for STORAGE_BACKEND=s3 ---
S3_BUCKET=
# Provider endpoint, e.g. https://fra1.digitaloceanspaces.com or https://<account>.r2.cloudflarestorage.com.
# Leave empty for AWS S3.
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the browser uses to load photos: bucket public URL or your CDN/custom domain,
# e.g. https://my-bucket.fra1.cdn.digitaloceanspaces.com . Defaults to <endpoint>/<bucket>.
S3_PUBLIC_BASE_URL=
# Optional folder inside the bucket, and addressing style override (path | virtual)
S3_KEY_PREFIX=
S3_ADDRESSING_STYLE=
MAX_UPLOAD_MB=10

# Enables POST /auth/create-master-admin when set (leave empty to disable)
MASTER_ADMIN_SETUP_PASSWORD=
